# Copy to backend/.env for local development. Never commit the real .env.

# ---- FlightAware AeroAPI ----
# Get a key at https://www.flightaware.com/aeroapi/portal  (header: x-apikey)
FLIGHT_API_KEY=
AIRPORT_ICAO=YPAD
AIRPORT_TZ=Australia/Adelaide

# What to show: international flights (origin outside Australia) plus these airlines (IATA codes).
# JQ = Jetstar, VA = Virgin Australia.
FLIGHT_AIRLINES=JQ,VA
FLIGHT_INTERNATIONAL=true
# any = airline OR international (default). all = airline AND international.
FLIGHT_FILTER_MODE=any

# Adelaide-time windows that decide which shift an arrival belongs to.
# Morning is 06:00-13:00. Night is everything else: 13:00 to 06:00 the next morning (counted as the earlier day's night shift).
MORNING_WINDOW=06:00-13:00
NIGHT_WINDOW=13:00-06:00

# FlightAware bills per result set of up to 15 flights.
# One update uses up to FLIGHT_MAX_PAGES sets per list (not yet arrived, and already arrived).
FLIGHT_MAX_PAGES=3
FLIGHT_INCLUDE_ARRIVED=true
FLIGHT_SYNC_MIN_INTERVAL_SECONDS=300
FLIGHT_MONTHLY_CALL_LIMIT=100
