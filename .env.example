# Copy to .env and change every value. Never commit the real .env.
POSTGRES_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Where the browser reaches the site (only matters if the frontend is served from another origin)
CORS_ORIGINS=http://localhost:8080
HTTP_PORT=8080

# Flight arrivals from FlightAware AeroAPI (see backend/.env.example for what each setting does)
FLIGHT_API_KEY=
AIRPORT_ICAO=YPAD
AIRPORT_TZ=Australia/Adelaide
FLIGHT_AIRLINES=JQ,VA
FLIGHT_INTERNATIONAL=true
FLIGHT_FILTER_MODE=any
MORNING_WINDOW=06:00-13:00
NIGHT_WINDOW=13:00-06:00
FLIGHT_MAX_PAGES=3
FLIGHT_INCLUDE_ARRIVED=true
FLIGHT_SYNC_MIN_INTERVAL_SECONDS=300
FLIGHT_MONTHLY_CALL_LIMIT=100
